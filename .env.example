# Copy this file to .env and replace the placeholders.
# Never commit .env. Values below are placeholders, not credentials.
#
# Variables without a VITE_ prefix are server/build environment only.
# VITE_ variables are exposed to the browser by Vite. Do not put secret keys in them.

# Google Gemini / Google API key. Same credential if you set more than one name.
API_KEY=AIza_replace_me
GOOGLE_API_KEY=AIza_replace_me
GEMINI_API_KEY=AIza_replace_me
VITE_GOOGLE_API_KEY=AIza_replace_me
VITE_GEMINI_API_KEY=AIza_replace_me

# Printful private token. Server-side only.
PRINTFUL_TOKEN=printful_replace_me

# Stripe secret key. Server-side only. Use a test key locally.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret. Server-side only.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Supabase project URL and publishable key (client).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Stripe publishable key (client).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional browser override for Printful. Prefer PRINTFUL_TOKEN on the server.
# If set, this value is visible in the browser.
VITE_PRINTFUL_API_KEY=printful_replace_me

# Firebase web API key (client).
VITE_FIREBASE_API_KEY=AIza_replace_me
